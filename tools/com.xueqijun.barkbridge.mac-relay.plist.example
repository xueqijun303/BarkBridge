<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xueqijun.barkbridge.mac-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/xueqijun/Documents/Codex/BarkBridge-release/tools/mac-wechat-relay.py</string>
    <string>--poll-url</string>
    <string>https://barkbridge-relay.xueqijun303.workers.dev/poll?secret=PUT_SECRET_HERE</string>
    <string>--interval</string>
    <string>1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/barkbridge-mac-relay.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/barkbridge-mac-relay.err</string>
</dict>
</plist>
