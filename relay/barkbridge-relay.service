[Unit]
Description=BarkBridge self-hosted relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=barkbridge
Group=barkbridge
EnvironmentFile=/etc/barkbridge-relay.env
WorkingDirectory=/opt/barkbridge-relay
ExecStart=/usr/bin/python3 /opt/barkbridge-relay/self-hosted-relay.py --host 0.0.0.0 --port ${BARKBRIDGE_RELAY_PORT} --db ${BARKBRIDGE_RELAY_DB} --secret ${BARKBRIDGE_RELAY_SECRET}
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/barkbridge-relay

[Install]
WantedBy=multi-user.target
